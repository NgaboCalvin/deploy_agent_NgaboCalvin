# Deployed projects are generated by ./deploy_agent.sh, so they are not source.
attendance_tracker_*/

# Runtime logs and timestamped archives produced by the application.
reports/
archives/
*.log

# Partial deployment ZIPs produced when a deployment is interrupted.
attendance_tracker_*_archive.zip

# macOS noise
.DS_Store

# Temporary files used while testing.
tmp/
*.tmp
*.bak
*.orig
